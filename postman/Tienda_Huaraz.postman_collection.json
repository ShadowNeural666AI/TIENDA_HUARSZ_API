{
  "info": {
    "name": "SENATI Tienda Huaraz API",
    "description": "Ejecutar en orden. Login y creación guardan tokens e id automáticamente. Solo se elimina el monitor creado por esta secuencia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "token_admin",
      "value": ""
